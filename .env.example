# Biometric Security Research System - Environment Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# BIOMETRIC CONFIGURATION
# =============================================================================

# Model selection: Facenet, VGG-Face, OpenFace, DeepFace, ArcFace
BIOMETRIC_MODEL=Facenet

# Detector backend: opencv, ssd, mtcnn, retinaface
BIOMETRIC_DETECTOR=opencv

# Similarity threshold (0.0 - 1.0)
BIOMETRIC_THRESHOLD=0.6

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# Enable encryption for sensitive data
ENABLE_ENCRYPTION=true

# Secure file deletion (multi-pass overwrite)
SECURE_DELETE=true

# Rate limiting
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Enable GPU acceleration (requires CUDA-enabled TensorFlow)
ENABLE_GPU=false

# Memory limit in MB
MEMORY_LIMIT_MB=4096

# Enable embedding cache
CACHE_EMBEDDINGS=true

# Batch size for processing
BATCH_SIZE=1

# Number of worker threads
NUM_WORKERS=1

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/biometric_security.log

# Enable console logging
ENABLE_CONSOLE_LOGGING=true

# Enable file logging
ENABLE_FILE_LOGGING=true

# Maximum log file size (bytes)
LOG_MAX_BYTES=10485760

# Number of backup log files
LOG_BACKUP_COUNT=5

# =============================================================================
# PATHS CONFIGURATION
# =============================================================================

# Data directories
DATA_DIR=data
ENROLLED_USERS_DIR=data/enrolled_users
TEST_SAMPLES_DIR=data/test_samples
ATTACK_SAMPLES_DIR=data/attack_samples
RESULTS_DIR=data/results
MODELS_DIR=biometric/models
LOGS_DIR=logs

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment: development, testing, production
ENVIRONMENT=development

# =============================================================================
# LIVENESS DETECTION CONFIGURATION
# =============================================================================

# Use dlib for facial landmarks (requires dlib installation)
USE_DLIB=true

# Eye aspect ratio threshold for blink detection
EAR_THRESHOLD=0.25

# Number of frames for blink detection
BLINK_FRAMES=2

# Texture entropy threshold
TEXTURE_ENTROPY_THRESHOLD=5.0

# Flash test duration (seconds)
FLASH_TEST_DURATION=2.0

# Flash difference threshold
FLASH_DIFFERENCE_THRESHOLD=10.0

# Color diversity threshold
COLOR_DIVERSITY_THRESHOLD=15.0

# =============================================================================
# ATTACK GENERATION CONFIGURATION
# =============================================================================

# Attack output directory
ATTACK_OUTPUT_DIR=data/attack_samples

# Photo glare intensity (0.0 - 1.0)
PHOTO_GLARE_INTENSITY=0.2

# Mask smoothing factor
MASK_SMOOTHING=15

# Degraded image quality (0-100, lower is worse)
DEGRADED_QUALITY=20

# Degraded scale factor
DEGRADED_SCALE_FACTOR=4

# =============================================================================
# COMPLIANCE AND PRIVACY
# =============================================================================

# Enable audit logging for compliance
ENABLE_AUDIT_LOGGING=true

# Audit log file
AUDIT_LOG_FILE=logs/audit.log

# Data retention period (days)
DATA_RETENTION_DAYS=90

# =============================================================================
# NOTES
# =============================================================================

# - DO NOT commit this file with real credentials to version control
# - Keep this file secure and restrict access
# - Review and update settings based on your security requirements
# - Ensure compliance with local privacy regulations
# - Test configuration changes in a development environment first
