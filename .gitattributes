# Auto detect text files and perform LF normalization
* text=auto

# Source code
*.py text eol=lf
*.sh text eol=lf
*.bash text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
*.rst text eol=lf

# Configuration
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Templates
*.jinja text eol=lf
*.j2 text eol=lf

# Git files
.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

# Windows files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.pkl binary
*.npy binary
*.npz binary
*.h5 binary
*.hdf5 binary
*.pb binary

# Images
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.bmp binary
*.ico binary
*.svg text

# Weights and models
*.dat binary
*.pth binary
*.pt binary
*.onnx binary
*.tflite binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.bz2 binary
*.7z binary

# Exclude from exports
.env export-ignore
.venv export-ignore
venv/ export-ignore
__pycache__/ export-ignore
*.pyc export-ignore
.pytest_cache/ export-ignore
.coverage export-ignore
htmlcov/ export-ignore
dist/ export-ignore
build/ export-ignore
*.egg-info/ export-ignore
